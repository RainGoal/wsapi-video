# Copy to .env for local use. scripts/Use-Env.ps1 imports it on Windows.
APP_ENV=development
# true permits missing SMTP/S3 credentials at startup for administrator setup.
# Registration/generation/payment still fail closed until their dependencies exist.
# Required when production credentials are maintained in the encrypted DB settings.
APP_SETUP_MODE=false
LISTEN_ADDR=127.0.0.1:8090
# Empty trusts no proxy. Set only the actual direct reverse-proxy peer CIDR(s).
# Trusted peers must overwrite X-Real-IP; never use 0.0.0.0/0 or ::/0.
TRUSTED_PROXY_CIDRS=
PUBLIC_URL=http://127.0.0.1:5176
DATABASE_URL=postgres://studio:studio-local-development@127.0.0.1:55432/postgres?sslmode=disable
APP_SECRET=replace-with-a-random-secret-of-at-least-32-characters
WEB_DIR=../web/dist
DEMO_MODE=false
STORAGE_DRIVER=local
STORAGE_DIR=../.runtime/media
MAX_UPLOAD_MIB=256
MAX_MEDIA_MIB=512
FFPROBE_PATH=ffprobe

# Explicit one-time admin creation; existing user roles/passwords are never changed.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Production requires APP_ENV=production, HTTPS PUBLIC_URL, private S3/R2 and SMTP.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# One fixed Sub2API origin, separate keys and versioned credential references.
SUB2API_ORIGIN=
IMAGE_CREDENTIAL_REF=image-v1
VIDEO_CREDENTIAL_REF=video-v1
SUB2API_IMAGE_KEY=
SUB2API_VIDEO_KEY=
# Preserve old key references while tasks are pending. JSON map ref -> secret.
MEDIA_KEYS_JSON={}
MEDIA_OUTPUT_ORIGINS=

# EasyPay credentials stay server-side; notifications actively verify provider state.
EASYPAY_ORIGIN=
EASYPAY_PID=
EASYPAY_KEY=
EASYPAY_CREDENTIAL_REF=easypay-v1
EASYPAY_KEYS_JSON={}
# EASYPAY_NOTIFY_URL and EASYPAY_RETURN_URL default from PUBLIC_URL.

{
  "name": "frame-studio-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5176",
    "build": "node scripts/build-notices.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/check-*.mjs",
    "format:check": "prettier --check src scripts *.json vite.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "vite": "7.3.0"
  }
}

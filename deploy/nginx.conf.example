# Example for an existing Nginx installation on the Docker host.
# Replace the domain and certificate paths before testing/reloading Nginx.
server {
    listen 80;
    server_name studio.example.com;
    return 301 https://studio.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name studio.example.com;
    ssl_certificate /etc/letsencrypt/live/studio.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/studio.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # MAX_UPLOAD_MIB=256 plus one MiB of multipart overhead.
    client_max_body_size 257m;
    client_body_timeout 120s;

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host studio.example.com;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Overwrite client input. Only configured direct proxy CIDRs may supply this.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_cache off;
        proxy_buffering off;
        proxy_request_buffering off;
        # The application currently limits a response to five minutes.
        proxy_read_timeout 310s;
        proxy_send_timeout 310s;
    }
}

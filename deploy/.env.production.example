# Copy to deploy/.env.production; this file contains no usable secrets.
# Use an independent production project/database/volume. Never use the Demo DB.
COMPOSE_PROJECT_NAME=frame-studio-production
# latest follows successful master builds. Pin sha-<commit> or a digest to deploy
# a specific build; record the previous digest before upgrading.
FRAME_IMAGE=ghcr.io/raingoal/wsapi-video:latest

# Compose enforces these values rather than reading the development .env.
APP_ENV=production
APP_SETUP_MODE=true
DEMO_MODE=false
STORAGE_DRIVER=s3
PUBLIC_URL=https://studio.example.com
# Comma-separated CIDRs of direct reverse-proxy peers as seen by the app.
# Empty trusts no headers. Use exact /32 or /128 peers where possible; a host
# proxy through Docker may appear as the bridge gateway, not 127.0.0.1.
# Never trust arbitrary public clients with 0.0.0.0/0 or ::/0.
TRUSTED_PROXY_CIDRS=

# Generate separate random 32-byte hexadecimal values (64 characters).
# POSTGRES_PASSWORD must be hexadecimal: Compose inserts it into a database URL.
# APP_SECRET must remain fixed and be backed up with the encrypted database.
POSTGRES_PASSWORD=
APP_SECRET=

# First startup only. An existing normal active admin permits empty fields later.
# At least 10 characters for the password. Use a unique production admin account.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Leave blank for initial admin setup in the encrypted database.
# Keep APP_SETUP_MODE=true on later restarts when using database-managed settings.
# The bucket must be private; production does not use local filesystem storage.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# The reverse proxy must allow multipart overhead in addition to MAX_UPLOAD_MIB.
MAX_UPLOAD_MIB=256
MAX_MEDIA_MIB=512
